# Drive server: serves one control-plane drive over SMB for LAN clients.
# Copy to drive.env and fill in the token. `make prism-drive-up` reads it.

# Drive slug in the control plane and the token issued for it (Drives page).
PRISMFS_DRIVE_SLUG=studio-share
PRISMFS_MANIFEST_TOKEN=paste-the-drive-token

# SMB share name; clients map \\<host>\opal.
PRISMFS_SMB_SHARE=opal

# Address the share binds on the host. 0.0.0.0 for every interface; the
# libvirt bridge (192.168.122.1) for a local VM only.
PRISMFS_DRIVE_BIND=0.0.0.0

# Control plane and S3 as seen from the dev-proxy docker network (plain HTTP,
# no TLS trust needed inside the container). For a remote control plane use
# https URLs and drop AWS_ALLOW_HTTP.
PRISMFS_CONTROL_PLANE=http://asset-library-web
AWS_ENDPOINT=http://asset-library-rustfs:9000
AWS_ALLOW_HTTP=true
AWS_ACCESS_KEY_ID=prismfs-dev
AWS_SECRET_ACCESS_KEY=prismfs-local-secret-change-me
AWS_DEFAULT_REGION=us-east-1
PRISMFS_S3_BUCKET=prismfs-dev

# Where access events go; defaults to <control plane>/prismfs/drives/<slug>/accesses.
#PRISMFS_AUDIT_URL=

# Seconds between manifest refreshes and access-event flushes.
PRISMFS_REFRESH_INTERVAL=10
PRISMFS_AUDIT_FLUSH_INTERVAL=5

RUST_LOG=prismfs=info
