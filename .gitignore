# Editors and operating systems
.DS_Store
.idea/
.vscode/
*.swp

# Local configuration and secrets
.env
.env.*
!.env.example

# Rust
services/prismfs/target/
services/prismfs/mnt/*
!services/prismfs/mnt/.gitkeep

# Laravel
apps/web/.env
apps/web/vendor/
apps/web/node_modules/
apps/web/public/build/
apps/web/public/hot
apps/web/public/storage
apps/web/storage/*.key
apps/web/storage/pail/
apps/web/.phpunit.cache/
apps/web/.phpunit.result.cache

# Local infrastructure
infrastructure/local/data/

# Secrets: only the SOPS-encrypted *.sops.yaml and the *.example.yaml
# templates are committed. A plaintext working copy is never committed, which
# is why the default here is to ignore everything else in the directory.
deploy/secrets/*.yaml
!deploy/secrets/*.example.yaml
!deploy/secrets/*.sops.yaml
.env.secrets
