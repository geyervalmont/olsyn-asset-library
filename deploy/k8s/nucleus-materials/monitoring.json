{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "monitoring.coreos.com/v1",
      "kind": "ServiceMonitor",
      "metadata": {
        "name": "nucleus-materials",
        "namespace": "opal",
        "labels": {
          "app.kubernetes.io/name": "nucleus-materials",
          "app.kubernetes.io/part-of": "opal"
        }
      },
      "spec": {
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "nucleus-materials",
            "app.kubernetes.io/part-of": "opal"
          }
        },
        "endpoints": [
          {
            "port": "metrics",
            "interval": "30s",
            "scrapeTimeout": "10s"
          }
        ]
      }
    },
    {
      "apiVersion": "monitoring.coreos.com/v1",
      "kind": "PrometheusRule",
      "metadata": {
        "name": "nucleus-materials",
        "namespace": "opal",
        "labels": {
          "app.kubernetes.io/name": "nucleus-materials",
          "app.kubernetes.io/part-of": "opal"
        }
      },
      "spec": {
        "groups": [
          {
            "name": "nucleus-materials",
            "rules": [
              {
                "alert": "NucleusMaterialsUnavailable",
                "expr": "kube_deployment_status_replicas_available{namespace=\"opal\",deployment=\"nucleus-materials\"} < 1",
                "for": "2m",
                "labels": {
                  "severity": "critical"
                },
                "annotations": {
                  "summary": "Nucleus material-library bridge has no ready replica"
                }
              },
              {
                "alert": "NucleusMaterialsTelemetryUnavailable",
                "expr": "up{namespace=\"opal\",service=\"nucleus-materials\"} == 0 or absent(up{namespace=\"opal\",service=\"nucleus-materials\"})",
                "for": "2m",
                "labels": {
                  "severity": "warning"
                },
                "annotations": {
                  "summary": "Nucleus material-library telemetry is unavailable"
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
