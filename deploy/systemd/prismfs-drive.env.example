# /etc/prismfs/<slug>.env for prismfs-drive@<slug>.service
PRISMFS_MOUNTPOINT=/srv/prismfs
PRISMFS_TENANT_ID=studio-share
PRISMFS_MANIFEST_URL=https://opal.example.com/prismfs/drives/studio-share/manifest.yaml
PRISMFS_MANIFEST_TOKEN=replace-me
PRISMFS_REFRESH_INTERVAL=30
PRISMFS_AUDIT_FLUSH_INTERVAL=5
AWS_ENDPOINT=https://s3.example.com
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
PRISMFS_S3_BUCKET=opal
RUST_LOG=prismfs=info
