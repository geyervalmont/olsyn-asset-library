APP_NAME="Olsyn Asset Library"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://asset-library.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=asset_library
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3
MEDIA_DISK=s3
MEDIA_MAX_FILE_SIZE=1073741824
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="asset-library@olsyn.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=prismfs-dev
AWS_SECRET_ACCESS_KEY=prismfs-local-secret-change-me
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=prismfs-dev
AWS_URL=https://s3.asset-library.test/prismfs-dev
AWS_ENDPOINT=http://asset-library-rustfs:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# The legacy corpus as staged for ingest, read by opal:import:legacy-files
# --disk=legacy. Falls back to the AWS_* credentials above when unset.
LEGACY_AWS_BUCKET=
LEGACY_AWS_ENDPOINT=
LEGACY_AWS_DEFAULT_REGION=

GERRY_API=http://host.docker.internal:4780
GERRY_ZONE=asset-library.test
VITE_DEV_HOST=vite.asset-library.test

VITE_APP_NAME="${APP_NAME}"

# Realtime: Reverb serves browsers via wss://ws.asset-library.test and LAN
# clients (the Revit VM) via ws://<bridge address>:8080.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=ws.asset-library.test
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

OPAL_REALTIME_SCHEME=http
OPAL_REALTIME_HOST=192.168.122.1
OPAL_REALTIME_PORT=8080

# Provider-neutral material similarity. Production uses the node's AWS role;
# no API key belongs in this file.
OPAL_EMBEDDINGS_ENABLED=false
OPAL_EMBEDDINGS_PROVIDER=bedrock
OPAL_EMBEDDINGS_MODEL=amazon.titan-embed-image-v1
OPAL_EMBEDDINGS_DIMENSIONS=1024
OPAL_EMBEDDINGS_REGION=ap-southeast-2
OPAL_EMBEDDINGS_REQUESTS_PER_MINUTE=60
