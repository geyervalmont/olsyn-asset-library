APP_NAME="Olsyn Asset Library"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://asset-library.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=asset_library
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
MEDIA_DISK=s3
MEDIA_MAX_FILE_SIZE=1073741824
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="asset-library@olsyn.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=prismfs-dev
AWS_SECRET_ACCESS_KEY=prismfs-local-secret-change-me
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=prismfs-dev
AWS_URL=https://s3.asset-library.test/prismfs-dev
AWS_ENDPOINT=http://asset-library-rustfs:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

GERRY_API=http://host.docker.internal:4780
GERRY_ZONE=asset-library.test
VITE_DEV_HOST=vite.asset-library.test

VITE_APP_NAME="${APP_NAME}"
