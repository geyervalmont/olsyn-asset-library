                        <DataGridTextColumn Header="Material Source" Binding="{Binding MaterialSource}" Width="230"/>
                        <DataGridTextColumn Header="Material Applied" Binding="{Binding CurrentMaterial}" Width="220"/>
                        <DataGridTextColumn Header="Pending Material" Binding="{Binding PendingMaterial}" Width="220"/>
                        <DataGridTextColumn Header="Editable" Binding="{Binding Editable}" Width="74"/>
                        <DataGridTextColumn Header="Scope" Binding="{Binding EditScope}" Width="130"/>
                        <DataGridTextColumn Header="Visible Count" Binding="{Binding VisibleCount}" Width="96"/>
                        <DataGridTextColumn Header="Targets" Binding="{Binding Targets}" Width="230"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140"/>
                        <DataGridTextColumn Header="Exposure" Binding="{Binding Exposure}" Width="280"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem x:Name="ceilings_tab" Header="Ceilings">
                <DataGrid x:Name="ceilings_grid"
                          AutoGenerateColumns="False"
                          CanUserSortColumns="True"
                          CanUserResizeColumns="True"
                          IsReadOnly="True"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F8FAFC"
                          ContextMenu="{StaticResource MaterialGridContextMenu}"
