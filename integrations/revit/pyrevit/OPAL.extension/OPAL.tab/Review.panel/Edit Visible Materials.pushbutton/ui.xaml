            </TabItem>

            <TabItem x:Name="other_tab" Header="Other">
                <DataGrid x:Name="other_grid"
                          AutoGenerateColumns="False"
                          CanUserSortColumns="True"
                          CanUserResizeColumns="True"
                          IsReadOnly="True"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F8FAFC"
                          ContextMenu="{StaticResource MaterialGridContextMenu}"
                          PreviewMouseRightButtonDown="on_grid_preview_mouse_right_button_down"
                          MouseDoubleClick="on_change_material">
                    <DataGrid.GroupStyle>
                        <GroupStyle ContainerStyle="{StaticResource MaterialGroupItemStyle}"/>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Element / Type" Binding="{Binding ElementGroup}" Width="250"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="130"/>
                        <DataGridTextColumn Header="Material Source" Binding="{Binding MaterialSource}" Width="230"/>
                        <DataGridTextColumn Header="Material Applied" Binding="{Binding CurrentMaterial}" Width="220"/>
                        <DataGridTextColumn Header="Pending Material" Binding="{Binding PendingMaterial}" Width="220"/>
                        <DataGridTextColumn Header="Editable" Binding="{Binding Editable}" Width="74"/>
                        <DataGridTextColumn Header="Scope" Binding="{Binding EditScope}" Width="130"/>
                        <DataGridTextColumn Header="Visible Count" Binding="{Binding VisibleCount}" Width="96"/>
                        <DataGridTextColumn Header="Targets" Binding="{Binding Targets}" Width="230"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140"/>
                        <DataGridTextColumn Header="Exposure" Binding="{Binding Exposure}" Width="280"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="Change Material"
                    Width="130"
                    Height="30"
                    Margin="0,0,8,0"
                    Click="on_change_material"/>
            <Button Grid.Column="1"
                    x:Name="by_category_highlight_button"
                    Content="Show Needs Amendment"
                    Width="190"
                    Height="30"
                    Margin="0,0,8,0"
                    Click="on_toggle_by_category_highlight"/>
            <Button Grid.Column="2"
                    x:Name="report_only_button"
                    Content="Show Report Only"
                    Width="150"
                    Height="30"
                    Margin="0,0,8,0"
                    Click="on_toggle_report_only"/>
            <Button Grid.Column="3"
                    Content="Clear Pending"
                    Width="112"
                    Height="30"
                    Click="on_clear_pending"/>
            <TextBlock Grid.Column="4"
                       x:Name="status_text"
                       Margin="12,0,12,0"
                       VerticalAlignment="Center"
                       Foreground="#475569"
                       TextWrapping="Wrap"/>
            <Button Grid.Column="5"
                    Content="Apply Updates"
                    Width="120"
                    Height="30"
                    Margin="0,0,8,0"
                    Click="on_apply"/>
            <Button Grid.Column="6"
                    Content="Close"
                    Width="86"
                    Height="30"
                    Click="on_close"/>
        </Grid>
    </Grid>
</Window>
